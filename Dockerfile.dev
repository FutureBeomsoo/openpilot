# Development Dockerfile for openpilot
# Uses pre-built openpilot-base image with volume mount for local development

FROM ghcr.io/commaai/openpilot-base:latest

# Ensure pyenv PATH is set
ENV PYENV_ROOT="/root/.pyenv"
ENV PATH="/root/.pyenv/bin:/root/.pyenv/shims:$PATH"

# Development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim \
    tmux \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Re-install poetry (removed in base image) - use full path
RUN /root/.pyenv/shims/pip install poetry==1.2.2

# Git safe directory for mounted volumes
RUN git config --global --add safe.directory '*'

# Working directory (will be mounted)
ENV OPENPILOT_PATH=/home/pbs/openpilot_ws/openpilot_e2e
ENV PYTHONPATH=${OPENPILOT_PATH}
WORKDIR ${OPENPILOT_PATH}

CMD ["/bin/bash"]
